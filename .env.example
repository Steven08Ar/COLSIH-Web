# ============================================================
#  COLSIH — Colegio Santa Isabel de Hungría
#  Archivo de configuración de entorno — PRODUCCIÓN
#  Copia este archivo como .env y completa los valores vacíos
# ============================================================


# ------------------------------------------------------------
#  APLICACIÓN
# ------------------------------------------------------------
APP_NAME="Colegio Santa Isabel de Hungría"
APP_ENV=production
APP_KEY=                        # Generar con: php artisan key:generate
APP_DEBUG=false
APP_URL=https://colsih.edu.co

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12


# ------------------------------------------------------------
#  LOGS
# ------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error                 # En producción usar "error", no "debug"


# ------------------------------------------------------------
#  BASE DE DATOS — MySQL
# ------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=colsih_laravel
DB_USERNAME=Admin_laravel
DB_PASSWORD=                    # Completar


# ------------------------------------------------------------
#  SESIONES
# ------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null


# ------------------------------------------------------------
#  CACHÉ / COLAS / FILESYSTEM
# ------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database


# ------------------------------------------------------------
#  CORREO — SMTP
#  Para Gmail: activar "Contraseñas de aplicación" en la cuenta
#  de Google y usar esa contraseña de 16 caracteres aquí.
# ------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com        # O el SMTP de tu hosting
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=contacto@colsih.edu.co
MAIL_PASSWORD=                  # Contraseña de aplicación Gmail (16 caracteres)
MAIL_FROM_ADDRESS="contacto@colsih.edu.co"
MAIL_FROM_NAME="Colegio Santa Isabel de Hungría"


# ------------------------------------------------------------
#  PANEL ADMINISTRATIVO
#  ADMIN_PATH: URL secreta del panel (no usar "admin" ni "panel")
#  Ejemplo: sih-gestion-2025
# ------------------------------------------------------------
ADMIN_PATH=                     # URL secreta — ej: sih-gestion-2025
ADMIN_USUARIO=                  # Usuario del panel
ADMIN_CLAVE=                    # Contraseña del panel (mínimo 12 caracteres)


# ------------------------------------------------------------
#  VITE (frontend — solo en desarrollo local)
# ------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
